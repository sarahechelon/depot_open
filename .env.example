# Depot environment template. Copy to .env and adjust.
# All settings are read from the process environment; no .env file is loaded in production.

# SQLite (default) or PostgreSQL connection string.
# Dev example: sqlite:///./depot.db
# Prod example: postgresql://depot:PASSWORD@db.internal:5432/depot
DEPOT_DATABASE_URL=sqlite:///./depot.db

# Optional Sentry DSN. Unset disables error reporting entirely.
# SENTRY_DSN=

# Optional feature flags (see app/flags.py). Any flag not listed defaults to false.
# DEPOT_FLAG_WEBHOOKS=true
